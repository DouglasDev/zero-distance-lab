    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@linaria/react": "7.0.1",
    "phaser": "4.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@napi-rs/canvas": "^1.0.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@wyw-in-js/vite": "1.1.0",
    "husky": "9.1.7",
    "oxfmt": "0.72.0",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  },
  "packageManager": "pnpm@10.12.4"
